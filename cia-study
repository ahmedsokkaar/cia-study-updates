function saveReviewedImport(){const checked=readPendingReview();const bad=checked.findIndex(q=>!q.q||q.options.length<3||q.options.slice(0,3).some(x=>!x||/\(Choice not detected in PDF\)/i.test(x)));if(bad>=0){$('importReviewMessage').textContent='Question '+(bad+1)+' needs the question text and at least three complete choices. Choice D is optional.';const el=document.querySelector('[data-review-index="'+bad+'"]');if(el)el.scrollIntoView({behavior:'smooth',block:'center'});return}const grouped={};checked.forEach(q=>{const name=q._bankName||q.source||'Reviewed questions';(grouped[name]||(grouped[name]=[])).push(q)});Object.keys(grouped).forEach(name=>saveQuestionBank(name,grouped[name]));scopedSet('ciaReviewQueue','[]');pendingImportQuestions=[];updateReviewQueueCount();$('importStage').textContent='Review complete';$('importDetail').textContent='Saved '+checked.length+' reviewed questions. They are available offline.';$('importStatus').textContent='Reviewed questions saved. Available offline.';home()}
