function review(){const box=$('review');box.classList.remove('hide');box.innerHTML='<h3>Answer review</h3>'+session.map((q,i)=>`<div class="review-item"><b>${i+1}. ${escapeHtml(q.q)}</b><p class="${answers[i]===q.answer?'':'muted'}">Your answer: ${answers[i]===null?'Not answered': 'ABCD'[answers[i]]+'. '+escapeHtml(q.options[answers[i]])}</p><p>Correct answer: <b>${q.answer===null||q.answer<0?'Not identified in source':('ABCD'[q.answer])+'. '+escapeHtml(q.options[q.answer])}</b></p><p class="muted">${escapeHtml(q.explanation)}</p></div>`).join('')}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}

