function setupExam(){show('examSetup');$('examAvailable').textContent=questions.length+' questions available in your bank.';$('realExamBtn').disabled=questions.length<125;$('miniExamBtn').disabled=questions.length<16;if(questions.length<125)$('examAvailable').textContent+=' Real Exam requires at least 125 questions; Mini Exam requires at least 16.';else if(questions.length<16)$('examAvailable').textContent+=' Mini Exam requires at least 16 questions.'}
function beginExamType(type){const n=type==='real'?125:16,mins=type==='real'?150:20;if(questions.length<n){$('examAvailable').textContent='You need at least '+n+' questions in your bank to start this exam. Currently available: '+questions.length+'.';return}start(type,n,mins)}
function start(m,n=questions.length,minutes=0){if(examTimerHandle){clearInterval(examTimerHandle);examTimerHandle=null}mode=m;examDurationSeconds=(m!=='practice'&&minutes>0)?minutes*60:0;examRemainingSeconds=examDurationSeconds;let pool=[...questions];for(let i=pool.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]]}session=pool.slice(0,Math.min(n,pool.length));idx=0;answers=Array(session.length).fill(null);submitted=false;startedAt=Date.now();show('quiz');$('examTimerWrap').classList.toggle('hide',mode==='practice'||examDurationSeconds===0);render();if(mode!=='practice'&&examDurationSeconds>0)startExamTimer()}
function render(){let q=session[idx];$('modeLabel').textContent=mode==='practice'?'PRACTICE MODE':(mode==='real'?'REAL EXAM MODE':'MINI EXAM');$('progressText').textContent=`Question ${idx+1} of ${session.length}`;$('progress').style.width=((idx+1)/session.length*100)+'%';$('topic').textContent=q.topic;$('question').textContent=q.q;const fb=$('questionFlag');if(fb){fb.classList.toggle('active',isFlagged(q));fb.textContent=isFlagged(q)?'⚑ Flagged':'⚐ Flag';}$('options').innerHTML='';$('feedback').classList.add('hide');$('next').disabled=true;$('next').textContent=idx===session.length-1?(mode!=='practice'?'Submit exam':'Finish practice'):'Next question';
q.options.forEach((o,i)=>{const b=document.createElement('button');b.className='option';b.innerHTML=`<span class="letter">${'ABCD'[i]}</span><span></span>`;b.lastChild.textContent=o;b.onclick=()=>choose(i);$('options').appendChild(b)});
if(answers[idx]!==null){if(mode==='practice')reveal();else{document.querySelectorAll('.option').forEach((b,i)=>{b.disabled=true;if(i===answers[idx])b.classList.add('correct')});$('next').disabled=false}}
}
function choose(i){if(answers[idx]!==null)return;answers[idx]=i;document.querySelectorAll('.option').forEach((b,j)=>{b.disabled=true;if(mode==='practice'){if(session[idx].answer!==null&&session[idx].answer>=0&&j===session[idx].answer)b.classList.add('correct');if(session[idx].answer!==null&&session[idx].answer>=0&&j===i&&i!==session[idx].answer)b.classList.add('wrong')}else if(j===i)b.classList.add('correct')});if(mode==='practice')reveal();else $('next').disabled=false}
function reveal(){let q=session[idx],known=q.answer!==null&&q.answer>=0,ok=known&&answers[idx]===q.answer;$('feedback').classList.remove('hide');$('feedback').innerHTML=`<strong>${!known?'Answer not identified in source':ok?'Correct ✓':'Not quite'}</strong><div>${q.explanation||''}</div><p class="small">${known?'Correct answer: '+('ABCD'[q.answer])+'. '+escapeHtml(q.options[q.answer]):'The source did not clearly identify the correct answer. Review the PDF before relying on this question.'}</p>`;$('next').disabled=false}
function nextQuestion(){if(answers[idx]===null)return;if(idx<session.length-1){idx++;render()}else finish()}
function startExamTimer(){updateExamTimer();examTimerHandle=setInterval(()=>{examRemainingSeconds--;updateExamTimer();if(examRemainingSeconds<=0){clearInterval(examTimerHandle);examTimerHandle=null;finish()}},1000)}
function updateExamTimer(){const sec=Math.max(0,examRemainingSeconds);$('examTimer').textContent=Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0');if(examDurationSeconds>0)$('examTimerFill').style.width=(sec/examDurationSeconds*100)+'%';if(sec<=60)$('examTimer').style.color='var(--bad)';else $('examTimer').style.color='var(--ink)'}
function finish(){if(submitted)return;if(examTimerHandle){clearInterval(examTimerHandle);examTimerHandle=null}submitted=true;let correct=answers.reduce((n,a,i)=>n+(session[i].answer!==null&&session[i].answer!==undefined&&session[i].answer>=0&&a===session[i].answer?1:0),0);let total=session.length;let gradable=session.filter(q=>q.answer!==null&&q.answer!==undefined&&q.answer>=0).length;let percent=total?Math.round(correct/total*100):0;let isExam=mode!=='practice';let passed=isExam&&percent>=80;$('score').textContent=percent+'%';$('right').textContent=correct+'/'+total;$('duration').textContent=mode==='real'?'Real Exam':mode==='mini'?'Mini Exam':'Practice';$('resultTitle').textContent=isExam?(passed?'Congratulations — You Passed!':'Unfortunately, You Did Not Pass'):(percent>=80?'Great work!':percent>=60?'Good progress':'Keep practicing');if(isExam){$('resultMessage').className='result-message '+(passed?'result-pass':'result-fail');$('resultMessage').innerHTML=passed?'<div class="celebration">🎉 🎊 🏆</div><h3>You passed the '+(mode==='real'?'Real Exam':'Mini Exam')+'!</h3><p>'+(mode==='real'?'You scored at least 600 out of 750. You are ready to go take the real CIA exam!':'You scored 80% or higher. Excellent work — keep this level up!')+'</p><div class="celebration">🎊 ✨ 🎉</div>':'<h3>Keep going — you can do it.</h3><p>You scored below 80%, so you did not pass this attempt. Review your mistakes, focus on the topics you found difficult, and try again.</p>';}else{$('resultMessage').className='';$('resultMessage').innerHTML='';}$('scaledScore').textContent=mode==='real'?'Scaled score: '+Math.round(correct/total*750)+' / 750 · Passing score: 600 / 750':(mode==='mini'?'Passing score: 80%':'');$('review').classList.add('hide');const h=JSON.parse(scopedGet('ciaHistory')||'[]');h.push({date:new Date().toISOString(),total,correct,percent,mode,passed});scopedSet('ciaHistory',JSON.stringify(h.slice(-100)));$('attempted').textContent=h.reduce((n,x)=>n+x.total,0);$('best').textContent