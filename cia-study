function deletePdfBank(i){const banks=JSON.parse(scopedGet('ciaImportedBanks')||'[]');if(!banks[i])return;const target=banks[i];const name=String(target.name||'Imported PDF');if(!confirm('Delete this PDF bank and ALL questions imported or reviewed from “'+name+'”? This cannot be undone.'))return;const sameName=v=>String(v||'Imported PDF').trim()===name.trim();const removedIds=new Set();banks.filter(b=>sameName(b.name)).forEach(b=>(b.questions||[]).forEach(q=>removedIds.add(String(q.id))));const belongsToBank=q=>removedIds.has(String(q.id))||sameName(q._bankName)||sameName(q.source)||sameName(q.topic);const remaining=banks.filter(b=>!sameName(b.name));scopedSet('ciaImportedBanks',JSON.stringify(remaining));scopedSet('ciaQuestionOverrides',JSON.stringify(JSON.parse(scopedGet('ciaQuestionOverrides')||'[]').filter(q=>!belongsToBank(q))));scopedSet('ciaReviewQueue',JSON.stringify(JSON.parse(scopedGet('ciaReviewQueue')||'[]').filter(q=>!belongsToBank(q))));pendingImportQuestions=(pendingImportQuestions||[]).filter(q=>!belongsToBank(q));questions=[...(window.EMBEDDED_QUESTIONS||[])];remaining.forEach(b=>questions.push(...(b.questions||[])));applyQuestionOverrides();$('count').textContent=questions.length;updateReviewQueueCount();renderDashboard();renderPdfLibrary();}
