function toggleFlagKey(key){let keys=getFlaggedKeys();keys=keys.includes(key)?keys.filter(x=>x!==key):keys.concat([key]);scopedSet('ciaFlaggedQuestions',JSON.stringify([...new Set(keys)]));renderBank();renderFlaggedQuestions();if(!$('quiz').classList.contains('hide')&&session[idx])render();}
function toggleFlagQuestion(q){toggleFlagKey(questionFlagKey(q))}
