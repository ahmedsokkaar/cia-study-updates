function deleteQuestion(i){const q=questions[i];if(!q)return;if(!confirm('Delete this question from your question bank? This cannot be undone.'))return;questions.splice(i,1);const manual=JSON.parse(localStorage.getItem('ciaManualQuestions')||'[]').filter(x=>String(x.id)!==String(q.id));localStorage.setItem('ciaManualQuestions',JSON.stringify(manual));const banks=JSON.parse(localStorage.getItem('ciaImportedBanks')||'[]');banks.forEach(b=>b.questions=(b.questions||[]).filter(x=>String(x.id)!==String(q.id)));localStorage.setItem('ciaImportedBanks',JSON.stringify(banks));const overrides=JSON.parse(localStorage.getItem('ciaQuestionOverrides')||'[]').filter(x=>String(x.id)!==String(q.id));localStorage.setItem('ciaQuestionOverrides',JSON.stringify(overrides));$('count').textContent=questions.length;renderEditorList()}
