function renderDashboard(){const h=JSON.parse(localStorage.getItem('ciaHistory')||'[]');const attempted=h.reduce((n,x)=>n+(Number(x.total)||0),0);const best=h.length?Math.max(...h.map(x=>Number(x.percent)||0)):0;const pct=questions.length?Math.min(100,Math.round((questions.length/125)*100)):0;const fill=$('dashProgressFill');if(fill)fill.style.width=pct+'%';const cap=$('dashProgressCaption');if(cap)cap.textContent=questions.length>=125?'You have enough questions for the Real Exam':questions.length+' of 125 questions toward a full exam';const pp=$('dashProgressPercent');if(pp)pp.textContent=pct+'%';const recent=$('dashRecentActivity');if(recent){if(!h.length){recent.innerHTML='<span class="dash-empty-icon">✦</span><p>No exams yet. Your results will appear here after your first attempt.</p>'}else{recent.innerHTML=h.slice(-3).reverse().map(x=>{const d=new Date(x.date);const when=isNaN(d.getTime())?'Recently':d.toLocaleDateString();const label=x.mode==='real'?'Real Exam':x.mode==='mini'?'Mini Exam':'Practice';return '<div class="dash-recent-item"><span class="dash-recent-badge">'+(x.passed?'✓':'↗')+'</span><div class="dash-recent-copy"><b>'+label+' completed</b><small>'+when+' · '+(x.correct||0)+'/'+(x.total||0)+' correct</small></div><span class="dash-recent-score">'+(x.percent||0)+'%</span></div>'}).join('')}}}
