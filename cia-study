function deletePdfBank(i){const banks=JSON.parse(localStorage.getItem('ciaImportedBanks')||'[]');if(!banks[i])return;const target=banks[i];const name=String(target.name||'Imported PDF');if(!confirm('Delete this PDF bank and ALL questions imported or reviewed from “'+name+'”? This cannot be undone.'))return;const removedIds=new Set();banks.filter(b=>String(b.name||'Imported PDF')===name).forEach(b=>(b.questions||[]).forEach(q=>removedIds.add(String(q.id))));const remaining=banks.filter(b=>String(b.name||'Imported PDF')!==name);localStorage.setItem('ciaImportedBanks',JSON.stringify(remaining));localStorage.setItem('ciaQuestionOverrides',JSON.stringify(JSON.parse(localStorage.getItem('ciaQuestionOverrides')||'[]').filter(q=>!removedIds.has(String(q.id)))));localStorage.setItem('ciaReviewQueue',JSON.stringify(JSON.parse(localStorage.getItem('ciaReviewQueue')||'[]').filter(q=>String(q._bankName||q.source||'Imported PDF')!==name)));reloadAllQuestions();updateReviewQueueCount();renderPdfLibrary()}
