function needsReview(q){const opts=(q.options||[]).map(x=>String(x||'').trim());const placeholder=opts.length<3||opts.some(x=>!x||/choice not detected|not detected/i.test(x));const unknown=q.answer===null||q.answer===undefined||q.answer<0||q.answer>3;return placeholder||unknown||!q.q||String(q.q).trim().length<12}
function saveQuestionBank(name,items){if(!items.length)return 0;const saved=JSON.parse(scopedGet('ciaImportedBanks')||'[]');const bankName=name||'Imported PDF';let bank=saved.find(b=>String(b.name||'Imported PDF')===String(bankName));if(!bank){bank={name:bankName,addedAt:new Date().toISOString(),questions:[]};saved.push(bank)}const added=items.map((q,i)=>{const out={...q,id:Date.now()+i+'-'+Math.random().toString(36).slice(2,7),topic:q.topic||bankName,source:q.source||bankName};delete out._reviewId;delete out._bankName;delete out.source_page;return out});bank.questions.push(...added);scopedSet('ciaImportedBanks',JSON.stringify(saved));questions=[...questions,...added];$('count').textContent=questions.length;renderDashboard();return added.length}
function onImportComplete(json,name){try{const added=JSON.parse(json);if(!Array.isArray(added)||!added.length)throw new Error('No questions found');const normalized=added.map((q,i)=>({...q,answer:(q.answer===null||q.answer===undefined||q.answer<0||q.answer>3)?null:q.answer,options:Array.isArray(q.options)?q.options.slice(0,4).map(x=>String(x||'').trim()):[],explanation:q.explanation||'',source:q.source||name,_reviewId:Date.now()+i,_bankName:name}));const good=normalized.filter(q=>!needsReview(q));const bad=normalized.filter(q=>needsReview(q));const savedCount=saveQuestionBank(name,good);const queue=JSON.parse(scopedGet('ciaReviewQueue')||'[]');queue.push(...bad);scopedSet('ciaReviewQueue',JSON.stringify(queue));pendingImportName='';pendingImportQuestions=[];$('importStage').textContent='Import complete';$('importDetail').textContent='Saved '+savedCount+' clear questions. '+bad.length+' question(s) with possible OCR problems were moved to the separate review page.';$('importMeterFill').style.width='100%';$('importPercent').textContent='100%';$('importPageCount').textContent=added.length+' questions processed';$('importStatus').textContent='Import complete: '+savedCount+' questions saved; '+bad.length+' need review. You can continue using the app.';updateReviewQueueCount();if(bad.length){openReviewQueue()}else home()}catch(e){onImportError('Could not prepare extracted questions: '+e.message)}}
function updateReviewQueueCount(){try{const n=JSON.parse(scopedGet('ciaReviewQueue')||'[]').length;$('reviewQueueCount').textContent=n;$('reviewQueueButton').classList.toggle('hide',n===0)}catch(e){}}
function openReviewQueue(){pendingImportQuestions=JSON.parse(scopedGet('ciaReviewQueue')||'[]');pendingImportName='';renderImportReview();show('importReview')}
function renderImportReview(){const list=$('importReviewList');$('importReviewCount').textContent=pendingImportQuestions.length+' questions';$('importReviewMessage').textContent='';if(!pendingImportQuestions.length){list.innerHTML='<p class="muted">Great! There are no questions waiting for review.</p>';return}list.innerHTML=pendingImportQuestions.map((q,i)=>{const opts=[0,1,2,3].map(j=>(q.options||[])[j]||'').map(x=>String(x));const placeholder=opts.some(x=>!x||/choice not detected|not detected/i.test(x));const unknown=q.answer===null||q.answer===undefined||q.answer<0||q.answer>3;const warning=placeholder||unknown||!q.q||q.q.length<12;return `<article class="import-review-card ${warning?'needs-review':''}" data-review-index="${i}"><div class="topline"><b>Question ${i+1}</b><span class="tag">${escapeHtml(q._bankName||q.source||'Imported PDF')} · Page ${escapeHtml(q.source_page||'?')}</span></div><p class="review-warning">Needs review: check the question, choices, and answer if shown in the source.</p><label>Question text</label><textarea id="reviewQ${i}">${escapeHtml(q.q||'')}</textarea>${['A','B','C','D'].map((letter,j)=>`<label>Choice ${letter}</label><textarea id="reviewO${i}_${j}">${escapeHtml(opts[j])}</textarea>`).join('')}<label>Correct answer (only select if verified)</label><select id="reviewA${i}"><option value="">Not confirmed</option>${['A','B','C','D'].map((l,j)=>`<option value="${j}" ${q.answer===j?'selected':''}>${l}</option>`).join('')}</select><label>Explanation (optional)</label><textarea id="reviewE${i}">${escapeHtml(q.explanation||'')}</textarea><div class="review-actions"><button class="action-btn danger" onclick="removePendingQuestion(${i})">Remove this question</button></div></article>`}).join('')}
function readPendingReview(){return pendingImportQuestions.map((q,i)=>{const options=[0,1,2,3].map(j=>$('reviewO'+i+'_'+j).value.trim());while(options.length>3&&!options[options.length-1])options.pop();return {...q,q:$('reviewQ'+i).value.trim(),options,answer:$('reviewA'+i).value===''?null:Number($('reviewA'+i).value),explanation:$('reviewE'+i).value.trim()}})}
