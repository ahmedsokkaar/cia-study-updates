function renderBank(){const term=($('bankSearch').value||'').trim().toLowerCase();const list=questions.filter(q=>!term||[q.q,q.topic,q.explanation,...(q.options||[])].join(' ').toLowerCase().includes(term));$('bankCount').textContent=list.length+' of '+questions.length+' questions';if(!list.length){$('bankList').innerHTML='<p class="muted">No questions match this search.</p>';return}$('bankList').innerHTML=list.map((q,i)=>{const ai=(q.answer!==null&&q.answer!==undefined&&q.answer>=0&&q.answer<4)?('ABCD'[q.answer]+'. '+escapeHtml(q.options[q.answer])):'Not identified in source';return '<article class="bank-card"><div class="topline"><span class="tag">'+escapeHtml(q.topic||'Imported question')+'</span><span>Question '+(i+1)+'</span></div><h3>'+escapeHtml(q.q)+'</h3>'+(q.options||[]).map((o,j)=>'<p><b>'+('ABCD'[j]||'')+'.</b> '+escapeHtml(o)+'</p>').join('')+'<div class="bank-answer"><b>Correct answer:</b> '+ai+(q.explanation?'<p>'+escapeHtml(q.explanation)+'</p>':'')+'</div>'+(q.source||q.source_page?'<p class="small">Source: '+escapeHtml(q.source||('Page '+q.source_page))+'</p>':'')+flagButton(q)+'</article>'}).join('')} 
function renderDashboard(){const h=JSON.parse(scopedGet('ciaHistory')||'[]');const attempted=h.reduce((n,x)=>n+(Number(x.total)||0),0);const best=h.length?Math.max(...h.map(x=>Number(x.percent)||0)):0;const pct=questions.length?Math.min(100,Math.round((questions.length/125)*100)):0;const fill=$('dashProgressFill');if(fill)fill.style.width=pct+'%';const cap=$('dashProgressCaption');if(cap)cap.textContent=questions.length>=125?'You have enough questions for the Real Exam':questions.length+' of 125 questions toward a full exam';const pp=$('dashProgressPercent');if(pp)pp.textContent=pct+'%';const recent=$('dashRecentActivity');if(recent){if(!h.length){recent.innerHTML='<span class="dash-empty-icon">✦</span><p>No exams yet. Your results will appear here after your first attempt.</p>'}else{recent.innerHTML=h.slice(-3).reverse().map(x=>{const d=new Date(x.date);const when=isNaN(d.getTime())?'Recently':d.toLocaleDateString();const label=x.mode==='real'?'Real Exam':x.mode==='mini'?'Mini Exam':'Practice';return '<div class="dash-recent-item"><span class="dash-recent-badge">'+(x.passed?'✓':'↗')+'</span><div class="dash-recent-copy"><b>'+label+' completed</b><small>'+when+' · '+(x.correct||0)+'/'+(x.total||0)+' correct</small></div><span class="dash-recent-score">'+(x.percent||0)+'%</span></div>'}).join('')}}}
